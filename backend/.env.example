# Database Configuration (Railway will set DATABASE_URL automatically)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname

# AI Provider Configuration
# Options: ollama, openai, anthropic, fallback
MIGRATION_AI_PROVIDER=ollama

# OpenAI Configuration (if using OpenAI)
# MIGRATION_OPENAI_API_KEY=sk-your-openai-api-key
# MIGRATION_OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (if using Anthropic)
# MIGRATION_ANTHROPIC_API_KEY=your-anthropic-api-key
# MIGRATION_ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama Configuration (if using Ollama)
MIGRATION_OLLAMA_BASE_URL=http://localhost:11434
MIGRATION_OLLAMA_MODEL=llama3.2

# Agent Configuration
MIGRATION_MAPPING_AUTO_THRESHOLD=0.85
MIGRATION_MAPPING_AMBIGUITY_GAP=0.12
MIGRATION_TARGET_MAX_RETRIES=3
MIGRATION_DEMO_MODE=true
